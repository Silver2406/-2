const grades = [
    { name: "Макар", score: 85 },
    { name: "Денис", score: 92 },
    { name: "Анна", score: 78 },
    { name: "Даша", score: 88 },
    { name: "Студент_X", score: 45 }
];

const avg = calculateAverage(grades);
console.log("1. Average score:", avg);


const max = findTopStudent(grades);
console.log("2. Top student:", max);

const failedList = filterFailed(grades);
console.log("3. Failed students:", failedList);


addLetterGrade(grades);
console.log("4. Grades with letters:", grades);

//функция подсчёта среднего бала студентов
function calculateAverage(data){
    let scoresum = 0;
    let itemsFound = 0;
    const len = data.length;
    for (let i = 0; i < len; i++) {
        const item = data[i];
        if (item.score) {
            scoresum = item.score + scoresum;
            itemsFound = itemsFound + 1;
        }
    }
    const averageScore = scoresum / itemsFound;
    return averageScore;
}

// поиск студента с максимальным баллом
function findTopStudent(data) {
    let maxscore = 0;
    let topStudent = null;
    const len = data.length;
    for (let i = 0; i < len; i++) {
        const current = data[i];
        if (current.score > maxscore) {
            maxscore = current.score;
            topStudent = current;
        }
    }
    return topStudent.name;
}

// должники
function filterFailed(data, passScore = 60) {
    let failedStudents = [];
    const len = data.length;
    for (let i = 0; i < len; i++) {
        const current = data[i];
        if (current.score < passScore) {
            failedStudents.push(current.name);
        }
    }
    return failedStudents;
}



// добавление нового поля
function addLetterGrade(data) {
    let itemsFound = 0;
    const len = data.length;
    for (let i = 0; i < len; i++) {
        const item = data[i];
        if (item.score) {
            itemsFound = itemsFound + 1;
            if (item.score >= 90) {
                item.letter = "A";
            } else if (item.score >= 75) {
                item.letter = "B";
            } else {
                item.letter = "C";
            }
        }
    }
    return itemsFound;
}
